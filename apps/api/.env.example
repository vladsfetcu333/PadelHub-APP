# PostgreSQL connection string. Local dev:  docker compose up -d postgres
# Production: Railway auto-provides this when you attach the Postgres plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/padel_dev"

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# 256-bit random secret for JWT signing. Regenerate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Anthropic API key for the chatbot (RAG with Claude Haiku 4.5). Optional in
# dev — chatbot routes return 400 with a clear message if missing.
# Sign up at https://console.anthropic.com/ for a free key.
ANTHROPIC_API_KEY=
