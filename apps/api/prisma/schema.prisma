// Padel Platform — Phase 4 domain model (PostgreSQL + pgvector).
// Migrated from SQLite in Phase 4; the embedding column on KnowledgeChunk
// is now a native pgvector `vector(384)` for fast cosine search via the
// `<=>` operator. JSON-as-string fields (photos, businessHours, scoreSets,
// ratingChanges, metadata, contextChunkIds) are kept as String for now —
// the service layer already round-trips them through JSON.{parse,stringify}.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  username     String  @unique
  phone        String?
  avatarUrl    String?

  // Personal
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  city        String
  bio         String?

  // Padel-specific
  padelLevel    Float         @default(3.0)
  preferredSide PreferredSide
  dominantHand  DominantHand
  playStyle     PlayStyle?
  playFrequency PlayFrequency
  goal          PlayerGoal

  // Glicko-2 (seeded from declared level on registration; updated after validated matches)
  glickoRating     Float @default(1500)
  glickoRD         Float @default(350)
  glickoVolatility Float @default(0.06)

  // Role
  role                UserRole @default(PLAYER)
  isCoach             Boolean  @default(false)
  coachCertifications String?

  // Matching prefs
  prefMaxLevelDiff     Float?
  prefGenderFilter     GenderFilter @default(ANY)
  prefAgeMin           Int?
  prefAgeMax           Int?
  prefRequireGoalMatch Boolean      @default(false)

  // Settings
  notifyByEmail     Boolean           @default(true)
  notifyInApp       Boolean           @default(true)
  profileVisibility ProfileVisibility @default(PUBLIC)

  // Status
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  availabilities       Availability[]
  favoriteClubs        UserFavoriteClub[]
  ownedClubs           Club[]                 @relation("ClubOwner")
  openMatchesCreated   OpenMatchPost[]        @relation("OpenMatchCreator")
  openMatchParticipations OpenMatchParticipant[]
  matchesAsT1P1        Match[]                @relation("T1P1")
  matchesAsT1P2        Match[]                @relation("T1P2")
  matchesAsT2P1        Match[]                @relation("T2P1")
  matchesAsT2P2        Match[]                @relation("T2P2")
  tournamentsOrganized Tournament[]           @relation("TournamentOrganizer")
  tournamentEntries    TournamentPlayer[]     @relation("TournamentPlayer")
  notifications        Notification[]
  chatSessions         ChatSession[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PreferredSide {
  LEFT
  RIGHT
  BOTH
}

enum DominantHand {
  LEFT
  RIGHT
}

enum PlayStyle {
  DEFENSIVE
  OFFENSIVE
  BALANCED
  BUILDER
}

enum PlayFrequency {
  ONCE_WEEK
  TWO_THREE_WEEK
  FOUR_PLUS_WEEK
}

enum PlayerGoal {
  RECREATIONAL
  COMPETITIVE
  MIXED
}

enum UserRole {
  PLAYER
  COACH
  CLUB_OWNER
  ADMIN
}

enum GenderFilter {
  ANY
  MALE_ONLY
  FEMALE_ONLY
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model Availability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Club {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  address     String
  city        String
  latitude    Float
  longitude   Float
  phone       String?
  email       String?
  website     String?

  photos String @default("[]")

  hasLockerRoom   Boolean @default(false)
  hasShowers      Boolean @default(false)
  hasCafe         Boolean @default(false)
  hasParking      Boolean @default(false)
  hasShop         Boolean @default(false)
  hasSchool       Boolean @default(false)
  hasRacketRental Boolean @default(false)

  businessHours String @default("{}")

  isVerified Boolean @default(false)
  ownerId    String?
  owner      User?   @relation("ClubOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courts       Court[]
  favoritedBy  UserFavoriteClub[]
  openMatches  OpenMatchPost[]
  matches      Match[]
  tournaments  Tournament[]

  @@index([city])
  @@index([latitude, longitude])
}

model Court {
  id               String        @id @default(cuid())
  clubId           String
  name             String
  type             CourtType
  location         CourtLocation
  surface          String?
  pricePerHour     Float?
  pricePerHourPeak Float?
  isActive         Boolean       @default(true)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

enum CourtType {
  PANORAMIC
  TRADITIONAL
  SINGLE_PADEL
}

enum CourtLocation {
  INDOOR
  OUTDOOR
}

model UserFavoriteClub {
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
}

// ──────────────────────────────────────────────────────────────────────
// Phase 2 — Open Matches and Match Recording
// ──────────────────────────────────────────────────────────────────────

model OpenMatchPost {
  id              String   @id @default(cuid())
  creatorId       String
  clubId          String
  scheduledAt     DateTime
  durationMinutes Int      @default(90)

  // Filtering criteria for who may join
  levelMin       Float?
  levelMax       Float?
  sideNeeded     PreferredSide? // null = any
  genderRequired GenderFilter  @default(ANY)
  goalRequired   PlayerGoal?    // null = any

  notes String?

  status OpenMatchStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User                   @relation("OpenMatchCreator", fields: [creatorId], references: [id])
  club         Club                   @relation(fields: [clubId], references: [id])
  participants OpenMatchParticipant[]
  resultMatch  Match?                 @relation("OpenMatchToMatch")

  @@index([scheduledAt])
  @@index([clubId])
  @@index([status])
}

enum OpenMatchStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model OpenMatchParticipant {
  id          String   @id @default(cuid())
  openMatchId String
  userId      String
  joinedAt    DateTime @default(now())

  openMatch OpenMatchPost @relation(fields: [openMatchId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([openMatchId, userId])
}

model Match {
  id   String    @id @default(cuid())
  type MatchType

  // Origin (one of)
  openMatchId       String? @unique
  // TODO Phase 3: add FK relation to TournamentMatch when the model exists.
  tournamentMatchId String? @unique

  // Players — positional, by team. 4 named relations required by Prisma.
  team1Player1Id String
  team1Player2Id String
  team2Player1Id String
  team2Player2Id String

  // Context
  clubId      String
  courtId     String?
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?

  status MatchStatus @default(SCHEDULED)

  // Score — JSON array: [{ team1Games, team2Games, team1TiebreakPoints?, team2TiebreakPoints? }, ...]
  scoreSets   String?
  winnerTeam  Int?   // 1 or 2

  // Validation: all 4 must confirm within 48h after scoreSets entered
  scoreEnteredAt DateTime?
  scoreEnteredBy String?
  confirmedT1P1  Boolean   @default(false)
  confirmedT1P2  Boolean   @default(false)
  confirmedT2P1  Boolean   @default(false)
  confirmedT2P2  Boolean   @default(false)
  isValidated    Boolean   @default(false)

  // Rating impact (filled after validation)
  ratingApplied Boolean @default(false)
  ratingChanges String? // JSON: { [userId]: { before: { rating, rd, vol }, after: {...}, delta } }

  // Dispute flag — Phase 3 will add admin-resolution tools
  isDisputed       Boolean @default(false)
  disputeReason    String?
  disputeRaisedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  openMatch    OpenMatchPost? @relation("OpenMatchToMatch", fields: [openMatchId], references: [id])
  club         Club           @relation(fields: [clubId], references: [id])
  team1Player1 User           @relation("T1P1", fields: [team1Player1Id], references: [id])
  team1Player2 User           @relation("T1P2", fields: [team1Player2Id], references: [id])
  team2Player1 User           @relation("T2P1", fields: [team2Player1Id], references: [id])
  team2Player2 User           @relation("T2P2", fields: [team2Player2Id], references: [id])

  @@index([scheduledAt])
  @@index([clubId])
  @@index([status])
}

enum MatchType {
  OPEN_MATCH
  TOURNAMENT
  FRIENDLY
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING_CONFIRMATION
  VALIDATED
  EXPIRED
  CANCELLED
}

// ──────────────────────────────────────────────────────────────────────
// Phase 3 — Tournaments
// ──────────────────────────────────────────────────────────────────────

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  format      TournamentFormat

  clubId      String
  organizerId String

  startDate DateTime
  endDate   DateTime?

  // Configuration
  maxPlayers           Int
  numberOfRounds       Int?
  pointsPerGame        Int     @default(1)
  matchDurationMinutes Int     @default(20)
  numberOfCourts       Int     @default(1)

  // Americano sub-mode: how pairs are generated each round.
  // ROTATION = social-golfer-style fixed schedule (every pair as evenly as possible)
  // BALANCED = top with bottom (high with low) — original Padel Hub default
  // TOP_TOGETHER = same-rank pairs (1+2, 3+4, ...)
  // RANDOM = random with previous-pair avoidance
  pairingMode AmericanoPairingMode @default(ROTATION)

  // Win/loss/draw points (Americano scoring)
  winPoints  Int @default(3)
  drawPoints Int @default(1)
  lossPoints Int @default(0)

  // Rules
  isPublic         Boolean @default(true)
  requiresApproval Boolean @default(false)
  minLevel         Float?
  maxLevel         Float?
  entryFee         Float?
  allowGuests      Boolean @default(true)

  status       TournamentStatus @default(DRAFT)
  currentRound Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      Club               @relation(fields: [clubId], references: [id])
  organizer User               @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  players   TournamentPlayer[]
  rounds    TournamentRound[]

  @@index([startDate])
  @@index([status])
  @@index([clubId])
}

enum TournamentFormat {
  AMERICANO
  MEXICANO
  ELIMINATION
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AmericanoPairingMode {
  ROTATION
  BALANCED
  TOP_TOGETHER
  RANDOM
}

model TournamentPlayer {
  id           String @id @default(cuid())
  tournamentId String

  // Either userId (registered) OR guest fields
  userId     String?
  guestName  String?
  guestLevel Float?

  seed           Int?
  totalGamesWon  Int  @default(0)
  totalGamesLost Int  @default(0)
  totalPoints    Int  @default(0)
  finalRank      Int?

  joinedAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?      @relation("TournamentPlayer", fields: [userId], references: [id])

  matchesT1P1 TournamentMatch[] @relation("TM_T1P1")
  matchesT1P2 TournamentMatch[] @relation("TM_T1P2")
  matchesT2P1 TournamentMatch[] @relation("TM_T2P1")
  matchesT2P2 TournamentMatch[] @relation("TM_T2P2")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

model TournamentRound {
  id           String    @id @default(cuid())
  tournamentId String
  roundNumber  Int
  startedAt    DateTime?
  completedAt  DateTime?

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@unique([tournamentId, roundNumber])
}

model TournamentMatch {
  id          String @id @default(cuid())
  roundId     String
  courtNumber Int?

  team1Player1Id String
  team1Player2Id String
  team2Player1Id String
  team2Player2Id String

  team1Score Int?
  team2Score Int?

  status      MatchStatus @default(SCHEDULED)
  startedAt   DateTime?
  completedAt DateTime?

  // Link to general Match record IF all 4 are registered users
  generalMatchId String? @unique

  round        TournamentRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team1Player1 TournamentPlayer @relation("TM_T1P1", fields: [team1Player1Id], references: [id])
  team1Player2 TournamentPlayer @relation("TM_T1P2", fields: [team1Player2Id], references: [id])
  team2Player1 TournamentPlayer @relation("TM_T2P1", fields: [team2Player1Id], references: [id])
  team2Player2 TournamentPlayer @relation("TM_T2P2", fields: [team2Player2Id], references: [id])

  @@index([roundId])
}

// ──────────────────────────────────────────────────────────────────────
// Phase 3 — Notifications
// ──────────────────────────────────────────────────────────────────────

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  body     String

  actionUrl String?

  // JSON-encoded payload for context (e.g. matchId, openMatchId)
  metadata String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  MATCH_RECOMMENDATION
  MATCH_INVITATION
  MATCH_SCHEDULED
  MATCH_SCORE_PENDING
  RATING_UPDATED
  TOURNAMENT_INVITATION
  TOURNAMENT_STARTING
  TOURNAMENT_COMPLETED
  CLUB_VERIFIED
  WELCOME
  GENERIC
}

// ──────────────────────────────────────────────────────────────────────
// Phase 3 — Chatbot / RAG
// ──────────────────────────────────────────────────────────────────────

model KnowledgeChunk {
  id       String @id @default(cuid())
  source   String
  category String

  content String

  // pgvector column — 384 dimensions to match the Xenova all-MiniLM-L6-v2
  // embedder. Bump the dim (and re-ingest) if you swap embedder. Prisma
  // doesn't model `vector` natively yet, so we use Unsupported<> and
  // access it via raw SQL in `lib/rag/retriever.ts` and the ingestion script.
  embedding Unsupported("vector(384)")

  // Content hash for idempotent re-ingestion
  contentHash String @unique

  createdAt DateTime @default(now())

  @@index([source])
  @@index([category])
  // Approximate-nearest-neighbour index (HNSW) for fast cosine search.
  // Defined explicitly in the migration SQL (see init migration), since
  // Prisma's @@index can't yet emit `USING hnsw (embedding vector_cosine_ops)`.
}

model ChatSession {
  id     String  @id @default(cuid())
  userId String
  title  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String

  // JSON array of KnowledgeChunk ids used as context for assistant messages
  contextChunkIds String?

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}
